{
 "title": "lsmkv",
 "uid": "lsmkv",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests/s by op and status",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (op, status) (rate(kv_requests_total[1m]))",
     "refId": "A",
     "legendFormat": "{{op}} {{status}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "p99 latency by op",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le, op) (rate(kv_request_seconds_bucket[1m])))",
     "refId": "A",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "WAL fsync p99",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(kv_wal_fsync_seconds_bucket[1m])))",
     "refId": "A",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "SSTables and compaction backlog",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "kv_sstables",
     "refId": "A",
     "legendFormat": ""
    },
    {
     "expr": "kv_compaction_backlog_tables",
     "refId": "B",
     "legendFormat": "backlog"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Compaction job age",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "kv_compaction_job_age_seconds",
     "refId": "A",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Replication lag (records)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "kv_replication_lag_records",
     "refId": "A",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Read amplification (tables probed per get)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "rate(kv_read_tables_probed[1m]) / clamp_min(sum(rate(kv_requests_total{op=\"get\"}[1m])), 1)",
     "refId": "A",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Disk bytes",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "kv_disk_bytes",
     "refId": "A",
     "legendFormat": ""
    }
   ]
  }
 ]
}